              "pm.test('Response has success message', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.equal('Matakuliah berhasil dihapus');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/matakuliah/6",
          "host": ["127", "0", "0", "1"],
          "port": "6543",
          "path": ["api", "matakuliah", "6"],
          "variable": [
            {
              "key": "base_url",
              "value": "http://127.0.0.1:6543"
            }
          ]
        },
        "description": "Menghapus matakuliah berdasarkan ID"
      },
      "response": []
    }
  ],
